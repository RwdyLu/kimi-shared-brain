{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080
  },
  "bot_name": "kimi-artifact-smoke-only",
  "cancel_open_orders_on_exit": true,
  "dry_run": true,
  "entry_pricing": {
    "order_book_top": 1,
    "price_side": "same",
    "use_order_book": true
  },
  "exchange": {
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "ccxt_config": {
      "enableRateLimit": true
    },
    "key": "",
    "name": "binance",
    "pair_blacklist": [],
    "pair_whitelist": [
      "ETH/USDT"
    ],
    "secret": ""
  },
  "exit_pricing": {
    "order_book_top": 1,
    "price_side": "same",
    "use_order_book": true
  },
  "fiat_display_currency": "USD",
  "force_entry_enable": false,
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  },
  "margin_mode": "",
  "max_open_trades": 1,
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "stake_amount": 50,
  "stake_currency": "USDT",
  "telegram": {
    "chat_id": "",
    "enabled": false,
    "token": ""
  },
  "timeframe": "4h",
  "tradable_balance_ratio": 0.2,
  "trading_mode": "spot"
}
